# Copy to .env and fill in. Never commit .env
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.5-flash
PORTAL_API_KEY=demo-key
FHIR_API_KEY=fhir-demo-key
LLM_CACHE=1          # reuse identical answers (instant re-runs); set 0 to always call the model
DEMO_MODE=0          # 1 on a public deployment: visitors browse, team password unlocks actions
ADMIN_PASSWORD=      # team password for demo mode
