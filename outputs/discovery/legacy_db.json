    "docs": {
      "ddl": {
        "PT_MSTR": "CREATE TABLE PT_MSTR (            -- patient master\n    PT_ID       TEXT PRIMARY KEY, -- MRN\n    PT_LST_NM   TEXT,\n    PT_FST_NM   TEXT,\n    PT_SX_CD    TEXT,             -- 1/2/9, see REF_CD\n    PT_BIRTH_DT   TEXT,             -- YYYYMMDD\n    PT_ADR_1    TEXT,\n    PT_CTY      TEXT,\n    PT_PST_CD   TEXT,\n    PT_CNTRY    TEXT,\n    PT_PH_NO    TEXT,\n    REC_UPD_TS  TEXT\n)",
        "ENC_HDR": "CREATE TABLE ENC_HDR (            -- encounter header\n    ENC_ID      TEXT PRIMARY KEY,\n    PT_ID       TEXT REFERENCES PT_MSTR(PT_ID),\n    ENC_TYP_CD  TEXT,             -- OP/ED/IP, see REF_CD\n    ADM_DT      TEXT,             -- YYYYMMDD\n    DSCH_DT     TEXT,             -- YYYYMMDD\n    ENC_STAT    TEXT              -- C = complete\n)",
        "DX_DTL": "CREATE TABLE DX_DTL (             -- diagnosis detail\n    DX_SEQ      INTEGER PRIMARY KEY AUTOINCREMENT,\n    ENC_ID      TEXT REFERENCES ENC_HDR(ENC_ID),\n    PT_ID       TEXT,\n    DX_CD       TEXT,             -- ICD-10, no dot (E119)\n    DX_DESC     TEXT,\n    DX_DT       TEXT,             -- YYYYMMDD\n    DX_STAT     TEXT              -- A = active\n)",
        "REF_CD": "CREATE TABLE REF_CD (             -- local code lookup\n    CD_TYP  TEXT,\n    CD_VAL  TEXT,\n    CD_DESC TEXT\n)"
      }
    }
  },
