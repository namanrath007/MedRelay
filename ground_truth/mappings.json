{
  "_about": "Answer key for the Map agent. target may be a list of equally valid answers. target=null means the field should NOT be mapped (lookup tables, surrogate/message keys). Score the agent with precision/recall against this file.",
  "id_crosswalk": {
    "legacy_db": "PT_MSTR.PT_ID is the MRN (master key)",
    "rest_api": "extRef holds the MRN; memberId is portal-only",
    "hl7_feed": "PID-3.1 holds the MRN (assigning authority LEGACYEHR, type MR)"
  },
  "legacy_db": [
    {"source": "PT_MSTR.PT_ID",      "target": "Patient.identifier.value",        "transform": "system=urn:fhirbridge:mrn"},
    {"source": "PT_MSTR.PT_LST_NM",  "target": "Patient.name.family",             "transform": "title_case"},
    {"source": "PT_MSTR.PT_FST_NM",  "target": "Patient.name.given",              "transform": "title_case"},
    {"source": "PT_MSTR.PT_SX_CD",   "target": "Patient.gender",                  "transform": "1->male, 2->female, 9->unknown"},
    {"source": "PT_MSTR.PT_DOB_DT",  "target": "Patient.birthDate",               "transform": "YYYYMMDD->YYYY-MM-DD"},
    {"source": "PT_MSTR.PT_ADR_1",   "target": "Patient.address.line",            "transform": "title_case"},
    {"source": "PT_MSTR.PT_CTY",     "target": "Patient.address.city",            "transform": "title_case"},
    {"source": "PT_MSTR.PT_PST_CD",  "target": "Patient.address.postalCode",      "transform": "none"},
    {"source": "PT_MSTR.PT_CNTRY",   "target": "Patient.address.country",         "transform": "IRL->IE"},
    {"source": "PT_MSTR.PT_PH_NO",   "target": "Patient.telecom.value",           "transform": "system=phone"},
    {"source": "PT_MSTR.REC_UPD_TS", "target": "Patient.meta.lastUpdated",        "transform": "YYYYMMDDhhmmss->ISO8601"},
    {"source": "ENC_HDR.ENC_ID",     "target": "Encounter.identifier.value",      "transform": "none"},
    {"source": "ENC_HDR.PT_ID",      "target": "Encounter.subject",               "transform": "reference Patient by MRN"},
    {"source": "ENC_HDR.ENC_TYP_CD", "target": "Encounter.class",                 "transform": "OP->AMB, ED->EMER, IP->IMP (v3-ActCode)"},
    {"source": "ENC_HDR.ADM_DT",     "target": "Encounter.period.start",          "transform": "YYYYMMDD->YYYY-MM-DD"},
    {"source": "ENC_HDR.DSCH_DT",    "target": "Encounter.period.end",            "transform": "YYYYMMDD->YYYY-MM-DD"},
    {"source": "ENC_HDR.ENC_STAT",   "target": "Encounter.status",                "transform": "C->finished"},
    {"source": "DX_DTL.DX_SEQ",      "target": null,                              "transform": "surrogate key, do not map"},
    {"source": "DX_DTL.ENC_ID",      "target": "Condition.encounter",             "transform": "reference Encounter"},
    {"source": "DX_DTL.PT_ID",       "target": "Condition.subject",               "transform": "reference Patient by MRN"},
    {"source": "DX_DTL.DX_CD",       "target": "Condition.code.coding.code",      "transform": "re-insert dot after 3rd char; system=ICD-10"},
    {"source": "DX_DTL.DX_DESC",     "target": "Condition.code.coding.display",   "transform": "sentence_case"},
    {"source": "DX_DTL.DX_DT",       "target": "Condition.onsetDateTime",         "transform": "YYYYMMDD->YYYY-MM-DD"},
    {"source": "DX_DTL.DX_STAT",     "target": "Condition.clinicalStatus",        "transform": "A->active"},
    {"source": "REF_CD.CD_TYP",      "target": null,                              "transform": "lookup table, used for transforms only"},
    {"source": "REF_CD.CD_VAL",      "target": null,                              "transform": "lookup table, used for transforms only"},
    {"source": "REF_CD.CD_DESC",     "target": null,                              "transform": "lookup table, used for transforms only"}
  ],
  "rest_api": [
    {"source": "memberId",             "target": "Patient.identifier.value",   "transform": "system=urn:careportal:member"},
    {"source": "extRef",               "target": "Patient.identifier.value",   "transform": "system=urn:fhirbridge:mrn (link key)"},
    {"source": "nm.first",             "target": "Patient.name.given",         "transform": "none"},
    {"source": "nm.last",              "target": "Patient.name.family",        "transform": "none"},
    {"source": "dob",                  "target": "Patient.birthDate",          "transform": "DD/MM/YYYY->YYYY-MM-DD"},
    {"source": "sx",                   "target": "Patient.gender",             "transform": "M->male, F->female, U->unknown"},
    {"source": "contact.mobile",       "target": "Patient.telecom.value",      "transform": "system=phone, use=mobile"},
    {"source": "contact.addr.street",  "target": "Patient.address.line",       "transform": "none"},
    {"source": "contact.addr.town",    "target": "Patient.address.city",       "transform": "none"},
    {"source": "contact.addr.eircode", "target": "Patient.address.postalCode", "transform": "none"},
    {"source": "portalStatus",         "target": "Patient.active",             "transform": "ACTIVE->true"}
  ],
  "hl7_feed": [
    {"source": "MSH-10",  "target": null,                                   "transform": "message control id, provenance only"},
    {"source": "PID-3.1", "target": ["Observation.subject", "Patient.identifier.value"], "transform": "MRN: patient identifier, and the lab result's subject reference"},
    {"source": "PID-5.1", "target": "Patient.name.family",                  "transform": "title_case"},
    {"source": "PID-5.2", "target": "Patient.name.given",                   "transform": "title_case"},
    {"source": "PID-7",   "target": "Patient.birthDate",                    "transform": "YYYYMMDD->YYYY-MM-DD"},
    {"source": "PID-8",   "target": "Patient.gender",                       "transform": "M->male, F->female, U->unknown"},
    {"source": "OBR-3",   "target": "Observation.identifier.value",         "transform": "none"},
    {"source": "OBX-3.1", "target": "Observation.code.coding.code",         "transform": "system=http://loinc.org"},
    {"source": "OBX-3.2", "target": "Observation.code.coding.display",      "transform": "none"},
    {"source": "OBX-5",   "target": "Observation.valueQuantity.value",      "transform": "to decimal"},
    {"source": "OBX-6",   "target": "Observation.valueQuantity.unit",       "transform": "UCUM"},
    {"source": "OBX-7",   "target": "Observation.referenceRange",           "transform": "split 'low-high'"},
    {"source": "OBX-8",   "target": "Observation.interpretation",           "transform": "H/L/N (v3-ObservationInterpretation)"},
    {"source": "OBX-11",  "target": "Observation.status",                   "transform": "F->final"},
    {"source": "OBX-14",  "target": "Observation.effectiveDateTime",        "transform": "YYYYMMDDhhmmss->ISO8601"}
  ]
}
